# ------------------------------
# Gestion des erreurs
# ------------------------------
ErrorDocument 404 /404.html

# ------------------------------
# Désactiver MultiViews (évite les conflits)
# ------------------------------
Options -MultiViews

# ------------------------------
# Activer la réécriture et définir base
# ------------------------------
RewriteEngine On
RewriteBase /

# ------------------------------
# Forcer le HTTPS (redirection permanente)
# ------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ------------------------------
# Rediriger /fichier.html -> /fichier  (canonical)
# ------------------------------
# Eviter boucles : si l'URL demande déjà sans .html et que le fichier physique existe, on passe.
RewriteCond %{THE_REQUEST} \s/([^\s?]*)\.html[^\s]* [NC]
RewriteRule ^ /%1 [R=301,L]

# ------------------------------
# Cacher l'extension .html (internally rewrite /page -> /page.html)
# ------------------------------
# Ne pas réécrire si c'est un dossier
RewriteCond %{REQUEST_FILENAME} !-d
# Si le fichier demandé existe déjà (images, css, js...), ne rien faire
RewriteCond %{REQUEST_FILENAME} !-f
# Si un fichier .html correspondant existe -> servir le .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]
